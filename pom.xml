<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for qits-configuration — the CONFIGURATION context: the deployment
         configuration entries an environment runs on, kept as versioned platform state instead of a
         hand-edited properties file on a volume.

         WHAT IT REPLACES. qits-platform-deployments read its extras from a file on its own config
         volume, snapshotted at boot: an edit was inert until the deployer was forced to reload, and
         a live `service update` env fix was reverted by the next deploy. This service owns
         the entries, versions every write, and serves them at the spelling the deployer already
         reads — so an edit is durable, attributable and reversible, and the next deployment carries
         it.

         WHAT IT DOES NOT DO. It stores, versions and serves; it parses nothing. A mount, a publish
         or an alias VALUE is read by qits-platform-deployments' own `ServiceExtras`, which stays
         the single parser on the platform. This repo validates the shape of a KEY and nothing else.

         DELIBERATELY ITS OWN GAV, the qits-events and qits-ci case: the child directories are
         `configuration` and `service`, and `eu.wohlben:service` would collide in the shared ~/.m2
         every workspace container mounts. So the coordinates are namespaced
         (`eu.wohlben.qits:qits-configuration-*`) while the directories stay short. The
         `configuration/` module's artifactId is `qits-configuration-domain` and not
         `qits-configuration-configuration`, which would be nonsense — the directory names the
         context, the artifactId names the layer.

         Versions that must stay in step with the platform (Quarkus, JDK release, MapStruct, Lombok)
         are duplicated here on purpose: a clone of THIS repo alone must build, with no monorepo and
         no parent to inherit from. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-configuration</artifactId>
    <!-- A PLACEHOLDER until this repo's first release train runs. The platform's release flow stamps
         a calver version onto the merge commit, as every released sibling carries, so nothing here
         is meant to be edited by hand. Deliberately NOT a -SNAPSHOT: the image build resolves this
         reactor from source, so a snapshot coordinate would only invite a resolver to look for one
         in a repository that will never hold it. -->
    <version>2026.904.205615</version>
    <packaging>pom</packaging>
    <name>qits-configuration</name>

    <modules>
        <!-- Listed first: `service` depends on it. -->
        <module>configuration</module>
        <module>service</module>
    </modules>

    <properties>
        <!-- THE PLATFORM'S OWN MAVEN REPOSITORY, and this repo's three artifacts from it:
             qits-db-core (PatientPgDriver, which the datasource opens every connection through, and
             DbRetry.inNewTx, which every write path runs in), qits-auth-core (the forward-auth
             mechanism and the machine-token gate) and qits-arch-rules (the test that refuses to let
             the datasource baseline go missing). All three are published by
             qits-integrations-quarkus. The url is a property so the image build can point it at the
             address the builder container can actually reach — see docker/Dockerfile and
             .qits-maven-settings.xml. -->
        <qits.db-core.version>2026.904.82648</qits.db-core.version>
        <qits.auth-core.version>2026.904.82648</qits.auth-core.version>
        <qits.arch-rules.version>2026.904.82648</qits.arch-rules.version>
        <!-- The user-story framework (test scope everywhere): service/src/test/.../stories/ and
             api/TokenValidationBootstrapIT are written as @UserStory methods, so a `verify` with
             the ITs opted in also regenerates service/target/userstories/ — the catalogue's own
             documentation, network diagram included, OBSERVED rather than narrated. This version is
             the one that SHIPS the RestAssured tap (NetworkTaps.restAssured), which is why the
             hand-copied StoryNetworkFilter is gone from this repository. Nothing in src/main knows
             any of it exists. -->
        <qits.userflows.version>2026.904.223009</qits.userflows.version>
        <!-- The recording service mocks the story ITs boot against (the generic MockService plus
             idp.MockIdp), released out of libs/qits-integrations-quarkus like the three jars above
             — the same-string policy applies the day this repo consumes a newer reactor of it. -->
        <qits.service-mock.version>2026.904.82648</qits.service-mock.version>
        <!-- The platform event bus client (qits-eventstream). This service SUBSCRIBES: it consumes
             qits-ci's `SoftwareRelease` off the durable bus and, for the project-agent image, writes
             the released version into its own config store. The eventstream jar brings the outbox
             datasource, the durable-consumer tables and the catch-up sweeper; the payload is decoded
             into a local record (bus/SoftwareReleaseListener), so no qits-ci module is on the path. -->
        <qits.eventstream.version>2026.904.82646</qits.eventstream.version>
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- Quinoa is a Quarkiverse extension: not in quarkus-bom, and its version does NOT track
             the platform's. 2.8.2 is built against Quarkus 3.27.3 LTS — older than the 3.34.6
             above, which is the direction that works, since an extension compiled against an older
             core runs on a newer one. 2.8.3 is built against 3.36.2 and would be an extension
             asking this core for API it may not have. Bump it only past a platform bump. Same pin
             as qits-platform-idp and every other SPA-serving service. -->
        <quinoa.version>2.8.2</quinoa.version>

        <!-- Embedded PostgreSQL for the suites. This service's store IS postgres, so every test that
             touches SQL has to run against one — and the first rule here is that a clone tests green
             with NO DOCKER, which rules out Testcontainers and Quarkus dev services alike. Zonky
             resolves real postgres binaries as ordinary Maven artifacts and spawns them as a child
             process: a maven dependency, not a container.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0 — the
             platform's own postgres tag), the library version is the harness around them, and they
             move independently. Every architecture the suite may run on is named explicitly in the
             modules that use it: the binaries are per-arch artifacts, and a missing one fails in the
             middle of a suite rather than during resolution. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- PackagedSurfaceIT runs against the BUILT artifact, so it needs a `package` to have
             happened. `-DskipITs=false` (or `-Dnative`, which flips this in service/pom.xml's
             profile) is how you ask for the artifact to be probed; a plain `./mvnw verify` on a
             fresh clone stays green without it.

             AND IT STAYS true NOW THAT TokenValidationBootstrapIT EXISTS, unlike qits-githost,
             which opts its service module back in. Failsafe has one run per module, so flipping
             this would drag PackagedSurfaceIT into every `mvn verify` — and half of that test is
             about the SPA, which the userflow pipeline deliberately does not build
             (`-Dquarkus.quinoa=false`). A quinoa-less run would then go red on a test that is
             right. The userflow run opts itself in by NAME instead:
             .config/qits/ci-event-userflows.yml passes
             `-DskipITs=false "-Dit.test=TokenValidationBootstrapIT"`, which is also the incantation
             to run the story by hand. -->
        <skipITs>true</skipITs>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE — 18.4.0, the tag the platform's own
                     qits-oci-postgresql image is built from. The suites migrate and query against
                     the same major version the deployment runs, which is the whole reason a real
                     server is spawned rather than an in-memory stand-in. Imported as a BOM because
                     the per-arch artifacts are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- The reactor's own module, so `service` depends on it version-less. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-configuration-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- Published by qits-integrations-quarkus into the platform Maven repository. The
                     forward-auth mechanism that turns qits-gateway's X-Qits-User / X-Qits-Roles into
                     an identity, and the machine-token gate beside it. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-auth-core</artifactId>
                <version>${qits.auth-core.version}</version>
            </dependency>
            <dependency>
                <!-- PatientPgDriver, named only by the datasource's `jdbc.driver` line, and
                     DbRetry.inNewTx, which every write in ConfigurationService runs inside. The
                     second is why `configuration` declares it at compile scope rather than
                     runtime. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-db-core</artifactId>
                <version>${qits.db-core.version}</version>
            </dependency>
            <dependency>
                <!-- The platform's shared rules, test scope. DatasourceBaselineRules is what this
                     repo takes them for. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-arch-rules</artifactId>
                <version>${qits.arch-rules.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules: the stories run in
                     the build and ship in nothing. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-userflows</artifactId>
                <version>${qits.userflows.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-service-mock</artifactId>
                <version>${qits.service-mock.version}</version>
            </dependency>
            <dependency>
                <!-- Managed here rather than versioned at the use site because Quinoa is in no BOM;
                     the pin and its reasoning stay in one place. -->
                <groupId>io.quarkiverse.quinoa</groupId>
                <artifactId>quarkus-quinoa</artifactId>
                <version>${quinoa.version}</version>
            </dependency>
            <dependency>
                <!-- The platform event bus, published by qits-eventstream into the platform Maven
                     repository. `service/` joins it to become a subscriber: the outbox datasource,
                     the durable-consumer tables, the catch-up sweeper and the stream subscriber all
                     arrive with this jar, configured by the defaults it ships. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-eventstream</artifactId>
                <version>${qits.eventstream.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <!-- Where the three qits jars above come from. Named `qits-maven` because the image
                 build's settings file mirrors exactly that id — see .qits-maven-settings.xml. -->
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the siblings disable it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
