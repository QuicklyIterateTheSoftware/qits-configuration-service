<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-configuration</artifactId>
        <version>2026.829.135707</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The configuration SERVICE layer: the JAX-RS routes over the configuration domain, the
         exception mapper that turns this context's ConfigurationException into its HTTP status, and
         the native-image reflection registration for what Jackson binds.

         A DEPLOYABLE APP, not a library jar — <packaging>quarkus</packaging> below is what says so.

         IT ALSO CARRIES THE CLIENT: Quinoa builds the SPA submodule at src/main/webui
         (qits-spa-configuration) during augmentation and serves it at /configuration/, beside this
         module's own /configuration/api and /configuration/q. That makes `./mvnw verify` need BOTH
         a node on PATH and an initialised submodule — `verify` runs `package` on its way to
         failsafe, and an empty webui/ stops it at "No package.json found in Web UI directory".
         `./mvnw test` still needs neither, because Quinoa is off in test mode.

         NEVER let quarkus-undertow onto this classpath. It arrives transitively from anything
         servlet-shaped; `./mvnw -pl service -am dependency:tree | grep -i undertow` before adding a
         dependency that sounds like a web framework. It was a sibling rule kept on principle while
         there was no client; now it is load-bearing here too — see the quinoa dependency below. -->
    <artifactId>qits-configuration-service</artifactId>
    <name>qits-configuration :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <!-- /configuration/q/health/ready — the readiness endpoint qits-platform-deployments'
                 health gate curls; the deployment convention every service answers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-configuration-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The configuration client. Quinoa runs the npm build in src/main/webui (the
                 qits-spa-configuration submodule) during augmentation and serves the result as
                 static resources at /configuration/ — see the quarkus.quinoa.* block in
                 application.properties. Version from the root pom's dependencyManagement.

                 IT IS WHY quarkus-undertow MUST STAY OUT. Quinoa's production static serving goes
                 through Quarkus' own static-resource route, which undertow's servlet stack takes
                 over and then cannot find — a packaged process that answers the API correctly and
                 the SPA with a 404. Nothing here needs a servlet: the whole surface is
                 quarkus-rest. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity and the HttpAuthenticationMechanism SPI. Two tracks of identity
                 reach this service: qits-gateway's X-Qits-User / X-Qits-Roles headers (a person),
                 and a bearer validated against qits-platform-idp (a machine, the deployer). Both
                 land as roles, which is why every route here is @RolesAllowed and none is open. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <!-- The machine half of the pair above: it validates the bearer. Gated by
                 quarkus.oidc.tenant-enabled in application.properties, so a clone-alone build needs
                 no issuer. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- The platform event bus client. Joining it here turns this deployable into a
                 subscriber: the outbox's datasource, its Flyway lineage, the durable-consumer tables
                 and the catch-up sweeper all arrive with this jar, configured by the defaults it
                 ships (its own META-INF/microprofile-config.properties). It brings quarkus-scheduler
                 and quarkus-websockets-next, both NEW to this deployable. The only thing this module
                 says about it is where it is dark — see application.properties. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The platform's shared rules. DatasourceBaselineRules is what this repo takes them
                 for, and it lives here because this module's config is the deployable's whole
                 config — the `configuration` datasource is declared in the domain jar. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The user-story framework: TokenValidationBootstrapIT is written as @UserStory
                 methods, so the packaged-boot proof doubles as documentation — steps, interactions
                 and a sequence diagram emitted under target/userstories/. Both its stories are
                 browserless (they take Interactions and no Flow), so the transitive Playwright
                 never launches anything and no Chromium is needed to build this module. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-userflows</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The recording service mocks. That IT points quarkus.oidc at idp.MockIdp — a
                 MockService plus key material: it serves the JWKS for a generated keypair, mints
                 tokens signed by it (and, on demand, by a key it never published), and records what
                 it answered, which is the far end of the story's interactions. Nothing else in this
                 repo can stand in for it: with the tenant gated off in every @QuarkusTest, the
                 shipped auth-server-url + jwks-path pair is fetched nowhere. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-service-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The store every @QuarkusTest here boots against, and the one PackagedSurfaceIT hands
                 to the launched process. testdb/EmbeddedPg + testdb/EmbeddedPgConfigSource hand the
                 running instance to Quarkus. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The fourth arch, and it is CI's. .config/qits/ci-event-userflows.yml runs
                 `mvn verify` in maven-base as `user: build`, and those step containers are Alpine
                 (musl): zonky picks the -alpine binaries there at run time, and
                 TokenValidationBootstrapIT's own embedded postgres is spawned by this module's
                 failsafe JVM. `user: build` is the same family of reason — initdb refuses to run as
                 root and calls getpwuid, so the step needs a passwd-backed non-root user.
                 qits-eventstream's pom carries the same fourth arch for the same pipeline. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar, and <packaging>quarkus</packaging>
                     above is what says so: it binds generate-code, generate-code-tests and build into
                     the lifecycle, so augmentation is not an execution someone can misplace. Drop
                     this <extensions>true</extensions> and the build stops at "Unknown packaging:
                     quarkus" rather than quietly producing nothing. Version comes from the root
                     pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- How @QuarkusIntegrationTest finds the compiled binary in a
                                     `-Dnative` build. The binary's name is
                                     quarkus.package.output-name in application.properties, NOT the
                                     maven finalName — with an output-name set,
                                     ${project.build.finalName}-runner is a path that does not
                                     exist, so the two have to be spelled the same here or a native
                                     IT launches nothing and passes. -->
                                <native.image.path>${project.build.directory}/qits-configuration</native.image.path>
                                <!-- The launched artifact takes a FREE port rather than queueing for
                                     Quarkus' default 8081 — which on the deployment host is the
                                     platform's own npm registry. The same value is set for the unit
                                     suite in src/test/resources. -->
                                <quarkus.http.test-port>0</quarkus.http.test-port>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the same profile every qits deployable carries): `-Dnative`
             disables the fast-jar and enables the native image. It lives in THIS module, not the
             root pom, because only this module is an application — `configuration` is a library jar
             with nothing to native-compile. skipITs flips with it so a native build runs
             PackagedSurfaceIT against the binary rather than skipping it silently. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
